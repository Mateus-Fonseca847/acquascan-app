{
  "name": "@acquascan/api",
  "version": "0.1.0",
  "private": true,
  "description": "API do AcquaScan: recebe leituras das estações, calcula o estado dos rios e serve o app",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@acquascan/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "18.0.4",
    "fastify": "5.12.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vitest": "5.0.2"
  }
}
