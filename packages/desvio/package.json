    "test": "vitest run"
  },
  "dependencies": {
    "@acquascan/roteamento": "workspace:*",
    "@acquascan/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "~6.0.3",
    "vitest": "5.0.2"
  }
}
