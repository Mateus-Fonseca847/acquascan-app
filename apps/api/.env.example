
# Banco local do docker-compose (credenciais só de desenvolvimento)
DATABASE_URL="postgresql://aquascan:aquascan@localhost:5432/aquascan"

# 0.0.0.0 permite que o celular na mesma rede Wi-Fi acesse a API
HOST=0.0.0.0
PORT=3333
NODE_ENV=development

# Ponto usado para a previsão do tempo (centro de Petrópolis)
PREVISAO_LATITUDE=-22.505
PREVISAO_LONGITUDE=-43.178

# Tokens das estações de teste criadas pelo seed.
# Troque por valores longos e aleatórios em qualquer ambiente real.
SEED_TOKEN_ESTACAO_1=dev-token-estacao-1
SEED_TOKEN_ESTACAO_2=dev-token-estacao-2

# Segredo que assina os tokens de login (mínimo de 32 caracteres).
# Este valor é só para desenvolvimento e a API recusa "dev-..." em produção.
# Gere um valor real com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-segredo-local-trocar-em-producao-0123456789
# Validade do token de login: número + s, m, h ou d
JWT_EXPIRA_EM=7d

# Atrás de um proxy (nginx, Render, Railway...) mude para true, ou para o número de proxies
# à frente da API (ex.: 1). Sem isso, todos os usuários parecem ter o mesmo IP (o do proxy)
# e dividem o limite de tentativas de login. Com a API exposta direto, deixe false:
# ligar sem proxy deixa qualquer um forjar o IP pelo cabeçalho X-Forwarded-For.
TRUST_PROXY=false

# Envio de notificações push quando o estado de um rio piora (RF08).
# false (padrão): nada é enviado e os alertas ficam pendentes no banco.
# Só ligue com o app em development build; o Expo Go não gera token de push.
PUSH_ENVIO_ATIVO=false
# Cooldown do push por estação, em minutos (antiflapping): depois de um push, outro alerta da
# mesma estação dentro dessa janela não envia notificação, a menos que seja mais grave (atenção ->
# crítico). 0 desliga. O alerta continua registrado e aparecendo no app. 30 é uma ESTIMATIVA inicial:
# ajuste com dados reais do sensor.
PUSH_COOLDOWN_MIN=30
# Endereço do Expo Push Service. Mude só para testar com um servidor falso local.
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# Endereço de consulta dos recibos (receipts) de entrega. Mude só para testar com um servidor falso.
EXPO_RECIBOS_URL=https://exp.host/--/api/v2/push/getReceipts
# Token de acesso do Expo, opcional: só é exigido se o "enhanced push security" estiver ligado
# no projeto (painel do EAS). É um segredo: nunca commite um valor real.
EXPO_ACCESS_TOKEN=
